# Required. Use a secret from your deployment secret manager.
MCP_API_TOKEN=replace-with-a-long-random-token
MCP_SESSION_SECRET=replace-with-a-long-random-secret

# Exact browser origin, never * in production.
CORS_ORIGIN=https://example.invalid

# TLS is terminated by the reverse proxy in front of this process.
HTTPS_TERMINATION=reverse-proxy

PORT=3000
HOST=127.0.0.1
NODE_ENV=development
